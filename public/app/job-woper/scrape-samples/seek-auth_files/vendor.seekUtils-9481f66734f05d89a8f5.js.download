  fragment role on Role {
    id
    title {
      text
      ontologyId
    }
    company {
      text
      ontologyId
    }
    seniority {
      text
      ontologyId
    }
    from {
      year
      month
    }
    to {
      year
      month
    }
    achievements
    tracking {
      events {
        key
        value
      }
    }
  }
`,v=(0,I.J1)`
  fragment unconfirmedRole on Role {
    ...role
  }
  ${P}
`,T=(0,I.J1)`
  fragment qualification on Qualification {
    id
    name {
      text
      ontologyId
    }
    institute {
      text
      ontologyId
    }
    completed
    completionDate {
      ... on Year {
        year
      }
      ... on MonthYear {
        month
        year
      }
    }
    formattedCompletion
    highlights
    status
    verificationUrl
    credential {
      credentialInfo {
        name
        values
      }
      manageVerificationUrl
      deleteVerificationUrl
    }
  }
`,S=(0,I.J1)`
  fragment unconfirmedQualification on Qualification {
    ...qualification
    tracking {
      events {
        key
        value
      }
    }
  }
  ${T}
`;(0,I.J1)`
  fragment languageProficiency on LanguageProficiency {
    id
    name {
      text
      ontologyId
    }
  }
`,(0,I.J1)`
  fragment licence on Licence {
    id
    name {
      text
      ontologyId
    }
    issuingOrganisation
    issueDate {
      month
      year
    }
    expiryDate {
      month
      year
    }
    noExpiryDate
    description
    status
    formattedDate
    verificationUrl
    verificationMessage
    credentialType
    credential {
      verification {
        result
      }
      credentialInfo {
        name
        values
      }
      manageVerificationUrl
      deleteVerificationUrl
      expiryStatus
    }
  }
`,(0,I.J1)`
  fragment personalStatement on CareerObjectives {
    personalStatement
  }
`,(0,I.J1)`
  fragment preferredClassification on Classification {
    id
    subClassification {
      id
    }
  }
`,(0,I.J1)`
  fragment resume on Resume {
    id
    createdDateUtc
    isDefault
    fileMetadata {
      name
      size
      virusScanStatus
      sensitiveDataInfo {
        isDetected
      }
      uri
    }
    origin {
      type
    }
  }
`,(0,I.J1)`
  query GetDocumentUploadData($id: UUID!) {
    viewer {
      documentUploadFormData(id: $id) {
        link
        key
        formFields {
          key
          value
        }
      }
    }
  }
`,(0,I.J1)`
  fragment skill on Skill {
    keyword {
      text
      ontologyId
    }
  }
`,(0,I.J1)`
  query HasResumeBeenParsed(
    $contextId: String!
    $contextType: UnconfirmedContextType!
    $languageCode: LanguageCodeIso!
  ) {
    viewer {
      unconfirmedDataForContext(
        contextId: $contextId
        contextType: $contextType
        languageCode: $languageCode
      ) {
        ... on UnconfirmedDataPending {
          completed
        }
        ... on UnconfirmedDataCompleted {
          completed
          roles {
            ...unconfirmedRole
          }
          qualifications {
            ...unconfirmedQualification
          }
        }
      }
    }
  }
  ${P}
  ${T}
