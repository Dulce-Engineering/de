{
  "liveServer.settings.port": 80,
  "liveServer.settings.root": "/public",
  "liveServer.settings.ignoreFiles": 
  [
    ".vscode/**", // Often good to ignore the .vscode folder itself
    "**/node_modules/**", // Ignores the entire node_modules directory
    "dist/**", // Ignores a 'dist' or build output folder
    "logs/**", // Ignores a 'logs' folder
    "**/*.log", // Ignores all files with the .log extension
    "public/job-woper/db/**" // Ignores a specific folder named 'ignored_folder_name'
  ],
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.formatOnSave": false,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "editor.scrollbar.vertical": "visible",
  "editor.scrollbar.horizontal": "visible",
  "editor.scrollbar.verticalScrollbarSize": 20,
  "editor.scrollbar.horizontalScrollbarSize": 16,
  "workbench.colorCustomizations": {
    "scrollbarSlider.background": "#ffffffbb",
    "scrollbarSlider.hoverBackground": "#ffffffff",
    "scrollbarSlider.activeBackground": "#ffffffff",
    "scrollbar.shadow": "#000000bb"
  }
}
