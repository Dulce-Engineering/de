{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": 
  [
    {
      "name": "Frontend",
      "request": "launch",
      "type": "chrome",
      "url": "http://127.0.0.1/app/jopr/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Backend",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmd /c npm run startem",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Scrape",
      "type": "node",
      "request": "launch",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}\\public\\app\\job-woper\\index.js",
      "cwd": "${workspaceFolder}\\public\\app\\job-woper"
    },
    {
      "name": "Deploy",
      "type": "node-terminal",
      "request": "launch",
      "command": "cmd /c npm run deploy",
      "cwd": "${workspaceFolder}"
    },
  ]
}